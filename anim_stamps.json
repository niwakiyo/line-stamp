{
  "name": "yusha_anim_stamp",
  "output": "output_anim",
  "preview": "preview_anim.gif",
  "window": { "top": "#3B4FD8", "bottom": "#141A6B", "text": "#FFFFFF", "shadow": "#0A0D3A" },
  "main_chara": "yusha",
  "main_expression": "tired",
  "main_blink": "calm",
  "tab_expression": "tired",
  "stamps": [
    { "chara": "yusha", "text": "ログイン\nしました…", "expression": "tired", "effects": ["ellipsis"],
      "anim": { "type": "type" } },
    { "chara": "yusha", "text": "HPが のこり1", "expression": "dead",
      "panel": { "type": "status", "rows": [{ "label": "HP", "value": 1, "max": 999, "color": "#E8414F" }] },
      "anim": { "type": "drain", "from_expression": "surprised" } },
    { "chara": "yusha", "text": "やる気が\nでない", "expression": "blank",
      "panel": { "type": "status", "rows": [{ "label": "やる気", "value": 0, "max": 100, "color": "#F7C843" }] },
      "anim": { "type": "drain", "from_expression": "tired" } },
    { "chara": "yusha", "text": "MPが たりない", "expression": "tired",
      "panel": { "type": "status", "rows": [{ "label": "MP", "value": 0, "max": 50, "color": "#5BC8FF" }] },
      "anim": { "type": "drain", "from_expression": "normal" } },
    { "chara": "yusha", "text": "帰りたい", "expression": "tired",
      "panel": { "type": "menu", "options": ["たたかう", "にげる"], "cursor": 1 },
      "anim": { "type": "cursor", "from_expression": "blank" } },
    { "chara": "yusha", "text": "おふとんから\nでられない", "expression": "calm", "pose": "down",
      "effects": [{ "name": "zzz", "dx": -30, "dy": -30 }], "anim": { "type": "bob", "body": "breath" } },
    { "chara": "yusha", "text": "むりです", "expression": "blank",
      "panel": { "type": "menu", "options": ["はい", "いいえ"], "cursor": 1 },
      "anim": { "type": "cursor", "from_expression": "tired" } },
    { "chara": "yusha", "text": "寝落ちしてた", "expression": "surprised", "effects": ["sweats"],
      "anim": { "type": "shake" } },
    { "chara": "yusha", "text": "ピキッ…", "expression": "angry", "effects": ["vein"],
      "anim": { "type": "shake", "pulse": true } },
    { "chara": "yusha", "text": "心が おれた", "expression": "gloomy", "effects": ["broken_heart"],
      "anim": { "type": "blink", "blink": "cry" } },
    { "chara": "yusha", "text": "本日の営業は\n終了しました", "expression": "tired", "effects": ["ellipsis"],
      "anim": { "type": "type" } },
    { "chara": "yusha", "text": "休ませて…", "expression": "tired",
      "panel": { "type": "menu", "options": ["やすむ", "ねる"], "cursor": 1 },
      "anim": { "type": "cursor", "from_expression": "calm" } },
    { "chara": "yusha", "text": "経験値には\nなった…", "expression": "cry", "effects": ["sparkle"],
      "anim": { "type": "bob" } },
    { "chara": "yusha", "text": "返信\nおくれました", "expression": "surprised", "effects": ["sweats"],
      "anim": { "type": "drip" } },
    { "chara": "yusha", "text": "すまぬ…", "expression": "sad", "effects": ["sweat"],
      "anim": { "type": "drip" } },
    { "chara": "yusha", "text": "感謝 +100", "expression": "happy", "effects": ["sparkles"],
      "anim": { "type": "hop" } },
    { "chara": "yusha", "text": "りょ(省エネ)", "expression": "blank",
      "anim": { "type": "blink", "blink": "calm", "at": [5] } },
    { "chara": "yusha", "text": "おつかれ\n(瀕死)", "expression": "dead", "pose": "down",
      "effects": [{ "name": "soul", "dx": -30, "dy": -20 }], "anim": { "type": "fall", "from_expression": "tired" } },
    { "chara": "yusha", "text": "セーブして\n寝る", "expression": "sleep", "effects": ["zzz"],
      "anim": { "type": "bob", "body": "breath" } },
    { "chara": "yusha", "text": "月曜日が\nあらわれた!", "expression": "surprised", "effects": ["exclaim"],
      "anim": { "type": "shake", "pulse": true } },
    { "chara": "yusha", "text": "ストレスが\nげんかい", "expression": "gloomy",
      "panel": { "type": "status", "rows": [{ "label": "ストレス", "value": 999, "max": 999, "color": "#FF7A45" }] },
      "anim": { "type": "drain", "from": 0, "from_expression": "normal" } },
    { "chara": "yusha", "text": "しかし なにも\nおこらなかった", "expression": "blank",
      "anim": { "type": "type" } },
    { "chara": "yusha", "text": "それはそう", "expression": "blank", "effects": ["sparkle"],
      "anim": { "type": "blink", "blink": "calm", "at": [4] } },
    { "chara": "yusha", "text": "メロい…", "expression": "love", "effects": ["hearts"],
      "anim": { "type": "hop", "heart": true } }
  ]
}
